# ==========================================
# Server Configuration
# ==========================================
# Host/IP address to bind the server to (default: "127.0.0.1")
LEAFWIKI_HOST=127.0.0.1

# Port to run the server on (default: "8080")
LEAFWIKI_PORT=__PORT__

# Path to a unix domain socket to listen on; overrides LEAFWIKI_HOST and LEAFWIKI_PORT
# LEAFWIKI_UNIX_SOCKET=/var/run/leafwiki.sock

# URL prefix when served behind a reverse proxy (e.g. /wiki)
LEAFWIKI_BASE_PATH=__PATH__

# Path to data directory (default: "./data")
LEAFWIKI_DATA_DIR=__DATA_DIR__/data

# Allow insecure HTTP; auth cookies may then travel in plain text
# LEAFWIKI_ALLOW_INSECURE=false

# ==========================================
# Admin Bootstrap
# ==========================================
# Initial admin username, used only if no admin exists (default: "admin")
LEAFWIKI_ADMIN_USERNAME=__ADMIN__

# Initial admin email, used only if no admin exists (default: "admin@localhost")
LEAFWIKI_ADMIN_EMAIL=__ADMIN_MAIL__

# Initial admin password, used only if no admin exists (min 8 characters)
LEAFWIKI_ADMIN_PASSWORD="__PASSWORD__"

# ==========================================
# Authentication & Security
# ==========================================
# Secret for signing auth tokens (JWT); REQUIRED unless LEAFWIKI_DISABLE_AUTH is set
LEAFWIKI_JWT_SECRET=__SECRET_KEY__

# Disable authentication completely (WARNING: only use in trusted networks!)
# LEAFWIKI_DISABLE_AUTH=false

# Key to encrypt per-user TOTP secrets at rest (min 32 bytes); unset keeps TOTP unavailable
LEAFWIKI_TOTP_ENCRYPTION_KEY=__TOTP_ENCRYPTION_KEY__

# Allow public access to the wiki with read access
# LEAFWIKI_PUBLIC_ACCESS=false

# Maximum admin+editor users allowed; 0 = unlimited (default: 0)
LEAFWIKI_EDITOR_LIMIT=0

# Access token timeout duration (e.g. 24h, 15m) (default: "15m")
LEAFWIKI_ACCESS_TOKEN_TIMEOUT=15m

# Refresh token timeout duration (e.g. 168h) (default: "168h")
LEAFWIKI_REFRESH_TOKEN_TIMEOUT=168h

# ==========================================
# External URLs / SSO
# ==========================================
# URL the frontend redirects to instead of the built-in login form (e.g. external SSO/IdP)
LEAFWIKI_LOGIN_URL=https://__DOMAIN__/yunohost/sso/login/?r=__REDIRECT_STRING__

# URL the frontend redirects to after logout (e.g. external SSO/IdP)
LEAFWIKI_LOGOUT_URL=https://__DOMAIN__/yunohost/sso/?action=logout

# External user-management page; replaces the built-in User Management UI with a link
# LEAFWIKI_USER_MANAGEMENT_URL=

# ==========================================
# Reverse-Proxy Authentication
# ==========================================
# Enable reverse-proxy authentication via HTTP header
LEAFWIKI_ENABLE_HTTP_REMOTE_USER=true

# HTTP header carrying the username or email from a trusted proxy (default: "Remote-User")
LEAFWIKI_HTTP_REMOTE_USER_HEADER_NAME=Ynh-User

# Auto-provision users asserted by the proxy but unknown to LeafWiki
LEAFWIKI_ENABLE_HTTP_REMOTE_USER_AUTO_CREATE=true

# Role assigned to auto-created users; must not be admin (default: "viewer")
LEAFWIKI_HTTP_REMOTE_USER_DEFAULT_ROLE=viewer

# HTTP header carrying the email for auto-created users
LEAFWIKI_HTTP_REMOTE_USER_EMAIL_HEADER_NAME=Ynh-User-Email

# Comma-separated trusted proxy IPs/CIDRs (e.g. 127.0.0.1,172.18.0.0/16)
LEAFWIKI_TRUSTED_PROXY_IPS=127.0.0.1,172.18.0.0/16

# ==========================================
# Email (SMTP)
# ==========================================
# SMTP host for password-reset/invite email; unset disables email entirely
LEAFWIKI_SMTP_HOST=__DOMAIN__

# SMTP server port (default: 587)
LEAFWIKI_SMTP_PORT=587

# SMTP transport security: none, starttls, or tls (default: "starttls")
LEAFWIKI_SMTP_SECURITY=starttls

# SMTP auth username
LEAFWIKI_SMTP_USERNAME=__APP__

# SMTP auth password
LEAFWIKI_SMTP_PASSWORD=__MAIL_PWD__

# From address for outgoing email (required when LEAFWIKI_SMTP_HOST is set)
LEAFWIKI_SMTP_FROM=__APP__@__DOMAIN__

# From display name for outgoing email (default: "LeafWiki")
LEAFWIKI_SMTP_FROM_NAME=LeafWiki __DOMAIN__

# Base URL for links in outgoing email, e.g. https://wiki.example.com (required with LEAFWIKI_SMTP_HOST)
LEAFWIKI_PUBLIC_URL=https://__DOMAIN____PATH__

# Timeout for a single SMTP send (e.g. 10s) (default: "10s")
# LEAFWIKI_SMTP_TIMEOUT=10s

# Skip TLS certificate verification for SMTP (do not use in production)
# LEAFWIKI_SMTP_INSECURE_SKIP_VERIFY=false

# ==========================================
# Frontend & Display Settings
# ==========================================
# Maximum size for asset uploads (e.g. 50MiB, 50MB, 52428800) (default: "50MiB")
LEAFWIKI_MAX_ASSET_UPLOAD_SIZE=__MAX_ASSET_UPLOAD_SIZE__

# Default UI language code (e.g. en, de); ignored unless the frontend ships it
# LEAFWIKI_DEFAULT_LANGUAGE=en

# A .css file inside the data dir, served as /custom.css (under LEAFWIKI_BASE_PATH when set)
# LEAFWIKI_CUSTOM_STYLESHEET=custom.css

# Hide the link metadata section in the frontend UI
# LEAFWIKI_HIDE_LINK_METADATA_SECTION=false

# Raw HTML/JS injected into <head> (analytics, custom CSS); trusted code only, not sanitized
# LEAFWIKI_INJECT_CODE_IN_HEADER=

# ==========================================
# Feature Flags
# ==========================================
# Enable the experimental API key management feature
# LEAFWIKI_ENABLE_API_KEY_MANAGEMENT=false

# Enable the link refactoring dialog and rewrite flow
# LEAFWIKI_ENABLE_LINK_REFACTOR=false

# Enable the revision / page history feature
# LEAFWIKI_ENABLE_REVISION=false

# ==========================================
# Revisions
# ==========================================
# Maximum revisions kept per page; 0 = unlimited (default: 100)
LEAFWIKI_MAX_REVISION_HISTORY=100

# Coalesce rapid successive saves by the same author (e.g. 5m); 0 = disabled (default: "5m")
LEAFWIKI_REVISION_COALESCE_WINDOW=5m

# ==========================================
# Git Backup
# ==========================================
# Enable git backup to a remote repository
# LEAFWIKI_GIT_BACKUP=false

# Git remote URL (SSH or HTTP(S)) for backups; leave unset for local-only backups
# LEAFWIKI_GIT_BACKUP_REMOTE=https://github.com/user/wiki-backup.git

# Git backup interval (e.g. 60m, 2h); 0 = manual-only (default: "60m")
#LEAFWIKI_GIT_BACKUP_INTERVAL=60m

# Git branch to push to (default: "main")
#LEAFWIKI_GIT_BACKUP_BRANCH=main

# Git commit author name for backups (default: "LeafWiki Backup")
#LEAFWIKI_GIT_BACKUP_AUTHOR_NAME="LeafWiki Backup"

# Git commit author email for backups (default: "backup@leafwiki.local")
#LEAFWIKI_GIT_BACKUP_AUTHOR_EMAIL=backup@leafwiki.local

# Username for HTTP(S) basic auth on http(s):// remotes
# LEAFWIKI_GIT_BACKUP_HTTP_USERNAME=git_user

# Password or access token for HTTP(S) basic auth
# LEAFWIKI_GIT_BACKUP_HTTP_PASSWORD=git_password_or_token

# Path to SSH private key for git backup
# LEAFWIKI_GIT_BACKUP_SSH_KEY_PATH=/path/to/id_rsa

# Raw SSH private key for git backup
# LEAFWIKI_GIT_BACKUP_SSH_KEY=

# known_hosts file for SSH host key verification (MITM protection)
# LEAFWIKI_GIT_BACKUP_SSH_KNOWN_HOSTS=/path/to/known_hosts

# ==========================================
# Snapshots & Restore
# ==========================================
# Enable full backup snapshots (ZIP incl. SQLite DB); set false to disable (default: true)
LEAFWIKI_SNAPSHOT=true

# Directory to store snapshot ZIPs in (default: <data-dir>/snapshots)
LEAFWIKI_SNAPSHOT_DIR=__DATA_DIR__/snapshots

# Snapshot interval (e.g. 24h, 6h); 0 = manual-only (default: "24h")
LEAFWIKI_SNAPSHOT_INTERVAL=24h

# Number of most recent snapshots to keep; <= 0 = keep all (default: 10)
LEAFWIKI_SNAPSHOT_RETENTION=10

# Maximum size of an uploaded backup ZIP to restore from (default: "500MiB")
LEAFWIKI_RESTORE_UPLOAD_MAX_SIZE=500MiB

# ==========================================
# Logging
# ==========================================
# Log level: debug, info, warn, error (default: "info")
LEAFWIKI_LOG_LEVEL=info

# Log output format: text or json (default: "text")
LEAFWIKI_LOG_FORMAT=text

# Suppress per-request HTTP access log lines
# LEAFWIKI_DISABLE_REQUEST_LOG=false

# ==========================================
# Metrics (Prometheus)
# ==========================================
# Enable the Prometheus /metrics endpoint on a separate listener
# LEAFWIKI_ENABLE_METRICS=false

# Host/IP address for the Prometheus metrics listener (default: "127.0.0.1")
#LEAFWIKI_METRICS_HOST=127.0.0.1

# Port for the Prometheus metrics listener (default: "9091")
#LEAFWIKI_METRICS_PORT=9091
